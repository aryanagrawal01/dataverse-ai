# DataVerse AI configuration — copy to .env and adjust.
# Every variable is optional in dev; sensible defaults apply.

# --- Core ---
ENVIRONMENT=dev                     # dev | staging | prod
SECRET_KEY=dev-secret-change-me     # REQUIRED in prod: signs session tokens
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- Database ---
# Dev default is SQLite (zero setup). Prod requires Postgres.
DATABASE_URL=sqlite:///./data/dataverse.db
# DATABASE_URL=postgresql+psycopg2://dataverse:dataverse@localhost:5432/dataverse

# --- File storage ---
STORAGE_BACKEND=local               # local | s3
STORAGE_PATH=./data/artifacts
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Limits ---
MAX_UPLOAD_MB=100
USER_QUOTA_MB=500
SESSION_TTL_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- LLM (optional: app fully works without it, AI features degrade gracefully) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL points the OpenAI SDK at any OpenAI-compatible endpoint
# instead of api.openai.com. Leave blank for native OpenAI. Example (Groq,
# cheap/fast, OpenAI-compatible):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_BUDGET_USD_PER_PROJECT=0.25
LLM_TIMEOUT_SECONDS=45

# --- Feature flags ---
ENABLE_CHAT=true
ENABLE_FORECASTING=true
ENABLE_INSIGHTS=true
